{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "dictionaries": [
    "en-gb",
    "project-terms",
    "softwareTerms",
    "python",
    "node",
    "bash",
    "html",
    "css",
    "docker",
    "companies",
    "filetypes",
    "networking-terms"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-terms",
      "path": "./.cspell/project-terms.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    "package-lock.json",
    "reports/**",
    "logs/**",
    "uploads/**",
    "samples/**/static/**",
    "samples/**/database_files/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.svg",
    "**/*.png",
    "**/*.pdf",
    ".cspell/**"
  ],
  "ignoreRegExpList": [
    "/fonts-noto-color-emoji/g",
    "/\\bcolor-emoji\\b/g",
    "/\\b\\w+Color\\b/g",
    "/\\bcolor\\s*:/g"
  ],
  "overrides": [
    {
      "filename": ["**/*.md"],
      "dictionaries": ["project-terms"],
      "flagWords": [
        "analyze->analyse",
        "analyzed->analysed",
        "analyzes->analyses",
        "analyzing->analysing",
        "analyzer->analyser",
        "analyzers->analysers",
        "authorization->authorisation",
        "authorize->authorise",
        "authorized->authorised",
        "authorizing->authorising",
        "unauthorized->unauthorised",
        "behavior->behaviour",
        "behaviors->behaviours",
        "behavioral->behavioural",
        "catalog->catalogue",
        "cataloging->cataloguing",
        "center->centre",
        "centered->centred",
        "color->colour",
        "colors->colours",
        "customization->customisation",
        "customize->customise",
        "customized->customised",
        "defense->defence",
        "fulfill->fulfil",
        "initialization->initialisation",
        "initialize->initialise",
        "initialized->initialised",
        "labeled->labelled",
        "labeling->labelling",
        "maximize->maximise",
        "minimization->minimisation",
        "minimize->minimise",
        "minimized->minimised",
        "modeling->modelling",
        "normalize->normalise",
        "optimization->optimisation",
        "optimize->optimise",
        "optimized->optimised",
        "organization->organisation",
        "organizational->organisational",
        "organizations->organisations",
        "organize->organise",
        "organized->organised",
        "practiced->practised",
        "practicing->practising",
        "prioritize->prioritise",
        "prioritized->prioritised",
        "recognize->recognise",
        "recognized->recognised",
        "sanitization->sanitisation",
        "sanitize->sanitise",
        "sanitized->sanitised",
        "specialization->specialisation",
        "specialize->specialise",
        "specialized->specialised",
        "summarize->summarise",
        "summarized->summarised",
        "synchronization->synchronisation",
        "synchronize->synchronise",
        "tunneling->tunnelling",
        "utilization->utilisation",
        "utilize->utilise",
        "utilized->utilised",
        "visualization->visualisation",
        "visualize->visualise",
        "visualized->visualised"
      ]
    }
  ],
  "useGitignore": true
}
